# ── Banco de dados ───────────────────────────────────────────
DATABASE_URL=postgresql://nexor_user:sua_senha@localhost:5432/nexor_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexor_db
DB_USER=nexor_user
DB_PASSWORD=sua_senha_aqui

# ── Autenticação ─────────────────────────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cole_aqui_a_chave_gerada
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://usenexor.site
ALLOWED_ORIGINS=https://usenexor.site,http://localhost:3000

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASE=price_...
STRIPE_PRICE_PLUS=price_1TU0GKGtCsA4ozfUDk32CIFX

# ── Integrações ──────────────────────────────────────────────
GROQ_API_KEY=gsk_...
ZAPI_INSTANCE_ID=...
ZAPI_TOKEN=...
ZAPI_CLIENT_TOKEN=...

# ── Administração ────────────────────────────────────────────
ADMIN_SECRET_KEY=chave_secreta_admin

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Railway (preenchido automaticamente em produção) ─────────
RAILWAY_PUBLIC_DOMAIN=
NEXOR_BACKEND_URL=
